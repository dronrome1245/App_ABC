package com.dronrome1245.appabc.domain.curriculum

import com.dronrome1245.appabc.domain.engine.LearningEngine
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertTrue
import org.junit.Test
import java.util.Random

class CurriculumTest {

    private val expectedIntroduced = mapOf(
        1 to listOf("А", "М"),
        2 to listOf("О", "У"),
        3 to listOf("С", "Н"),
        4 to listOf("И", "Т", "К"),
        5 to listOf("Л", "Р", "В"),
        6 to listOf("Д", "П", "Б"),
        7 to listOf("З", "Г", "Е", "Я"),
        8 to listOf("Ш", "Ж", "Ч", "Щ", "Х", "Ц", "Э", "Ю", "Ё", "Ы", "Ь", "Ъ", "Й", "Ф")
    )

    @Test
    fun curriculumV3ContainsEightOwnerApprovedLevelsAndTenQuestions() {
        val curriculum = ApprovedCurriculum.curriculum

        assertEquals(3, ApprovedCurriculum.VERSION)
        assertEquals(8, curriculum.levels.size)
        expectedIntroduced.forEach { (levelId, letters) ->
            assertEquals(letters, curriculum.level(levelId).introducedLetters.map { it.symbol })
            assertEquals(10, curriculum.level(levelId).questionCount)
        }
    }

    @Test
    fun studiedPoolAccumulatesToAll33Letters() {
        val curriculum = ApprovedCurriculum.curriculum
        val expectedPoolSizes = mapOf(
            1 to 2,
            2 to 4,
            3 to 6,
            4 to 9,
            5 to 12,
            6 to 15,
            7 to 19,
            8 to 33
        )

        expectedPoolSizes.forEach { (levelId, expectedSize) ->
            val pool = curriculum.lettersAvailableAt(levelId).map { it.symbol }
            assertEquals(expectedSize, pool.size)
            (1 until levelId).flatMap { expectedIntroduced.getValue(it) }.forEach { previous ->
                assertTrue(previous in pool)
            }
        }

        val finalPool = curriculum.lettersAvailableAt(8).map { it.symbol }
        assertEquals(33, finalPool.distinct().size)
        assertEquals(RussianAlphabet.symbols.toSet(), finalPool.toSet())
    }

    @Test
    fun distractorPoolForEveryLevelUsesStudiedLettersAndExcludesTarget() {
        val curriculum = ApprovedCurriculum.curriculum

        (1..8).forEach { levelId ->
            val allowed = curriculum.lettersAvailableAt(levelId).map { it.symbol }.toSet()
            allowed.forEach { target ->
                val distractors = curriculum.distractorPool(levelId, target).map { it.symbol }
                assertFalse(target in distractors)
                assertTrue(distractors.all { it in allowed })
                assertEquals(allowed.size - 1, distractors.distinct().size)
            }
        }
    }

    @Test
    fun learningEngineGeneratesTenValidQuestionsForEachApprovedLevel() {
        (1..8).forEach { levelId ->
            val pool = ApprovedCurriculum.curriculum.lettersAvailableAt(levelId)
            val allowed = pool.map { it.symbol }.toSet()
            val engine = LearningEngine(pool, random = Random(levelId.toLong()))
            val lastTargets = mutableListOf<String>()

            repeat(10) {
                val task = engine.nextTask(lastTargets)
                assertTrue(task.target.symbol in allowed)
                assertEquals(2, task.options.size)
                assertTrue(task.options.any { option -> option.symbol == task.target.symbol })
                assertTrue(task.options.all { option -> option.symbol in allowed })
                assertEquals(2, task.options.map { option -> option.symbol }.distinct().size)
                lastTargets += task.target.symbol
            }
        }
    }

    @Test
    fun everyRussianLetterHasSpokenNameAndIntroducedLevel() {
        val letters = ApprovedCurriculum.curriculum.lettersAvailableAt(8)
        assertEquals(33, letters.size)
        assertTrue(letters.all { it.spokenName.isNotBlank() })
        assertTrue(letters.all { it.levelIntroduced in 1..8 })
    }
}
